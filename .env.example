# Opcional: URL HTTPS pública ou caminho relativo do seu endpoint de leads.
# O endpoint deve aceitar POST JSON com name, email, phone e company.
# Resposta 2xx confirma o recebimento; qualquer outro status exibe erro.
# Caso esteja em outro domínio, permita CORS para o domínio do site.
# VITE_* é público no navegador. Nunca inclua tokens ou segredos aqui.
VITE_LEAD_ENDPOINT=
